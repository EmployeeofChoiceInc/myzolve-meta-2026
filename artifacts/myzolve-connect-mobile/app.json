{
  "expo": {
    "name": "MyZolve Connect Mobile",
    "slug": "myzolve-connect-mobile",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myzolve-connect-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "7",
      "usesAppleSignIn": true
    },
    "android": {
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MyZolve Connect to save photos from your circle to your photo library.",
          "savePhotosPermission": "Allow MyZolve Connect to save photos from your circle to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
